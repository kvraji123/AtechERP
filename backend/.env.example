NODE_ENV=production
AUTH_MODE=accounts
AUTH_SESSION_HOURS=8
# Keep true for HTTPS. Set false only while the application is served over HTTP.
AUTH_COOKIE_SECURE=true
# Set these only for the first start after npm run migrate:app-user-auth.
# Use unique passwords of at least 12 characters, and keep this file out of source control.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_PASSWORD=
# Optional first Standard User account. Set all three values or leave all blank.
INITIAL_STANDARD_USERNAME=
INITIAL_STANDARD_NAME=
INITIAL_STANDARD_PASSWORD=

HOST=127.0.0.1
PORT=4100

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=atech_user
DB_PASSWORD=change_me
DB_NAME=atech_erp
# Labour enquiries and their marketing workflow records are stored here.
# Customer and supplier masters remain in DB_NAME.
CMS_DB_NAME=cms_erp
DEFAULT_TENANT_ID=DEFAULT
DEFAULT_COMPANY_ID=

# In-app Tool List editing via a self-hosted ONLYOFFICE Document Server.
# DOCUMENT_SERVER_URL is the browser-visible URL. PUBLIC_API_URL must be
# reachable from the Document Server (for a Docker server on this Windows PC,
# use http://host.docker.internal:4100). Use one long random shared secret.
ONLYOFFICE_DOCUMENT_SERVER_URL=
ONLYOFFICE_PUBLIC_API_URL=
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_EDITOR_SESSION_MINUTES=480

# RFQ SMTP delivery. Leave this false while supplier emails are reviewed in the internal outbox.
RFQ_EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Atech Automation Purchase Team"
SMTP_WORKER_INTERVAL_MS=30000
USER_TENANT_MAP_JSON={}
